<vertical id='background-container' bg='round-rect-panel' horizontal-fit='Unconstrained' pad='1'>
  <horizontal>      
	  <vertical pad-top='3' pad-bottom='3' pref-width='5'>
          <text text='~player-rank' align='Left' font-size='4' word-wrapping='false'/>   
      </vertical>
      <vertical pad-top='1' pad-bottom='1' pref-width='7'>
          <image id='avatar' pref-height='6' pref-width='6' preserve-aspect='true'/>
      </vertical>
      <vertical pad-top='1' pad-bottom='1' pref-width='50'>
          <text text='~player-name' align='Left' font-size='3.5' word-wrapping='false'/>
      </vertical>
          <vertical pad-top='1' pad-bottom='1' pref-width='12'>
          <text text='~player-ap' align='Center' font-size='3.5' word-wrapping='false'/>
      </vertical>
  </horizontal>
</vertical>