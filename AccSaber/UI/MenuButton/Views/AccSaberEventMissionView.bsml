<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <vertical active='~active'>
    <horizontal pad='2' spacing='1.5' child-expand-width='false'>
      <vertical pref-width='55' pad='2' pref-height='45' child-expand-height='false' bg='panel-top' skew='0'>
        <text id='event-title' text='~event-title' font-size='6' align='Left'/>
        <text text='~event-duration' font-size='4' color='#22c55e' align='Left'/>
        <text text='~event-current-week' font-size='3' color='#5e5973' align='Left'/>
        <text id='event-description' text='~event-description' word-wrapping='true' font-size='3.5' color='grey' align='Left'/>
      </vertical>
      <vertical pref-width='75' child-expand-height='false' bg='panel-top' skew='0' active='~event-begun'>
        <horizontal>
          <horizontal pad='2' pref-width='45' pref-height='10' vertical-fit='PreferredSize' horizontal-fit='PreferredSize' child-expand-width='false' spacing='-1'>
            <text text='~week-current' align='Left' font-size='5'/>
            <img src='~lockImg' preserve-aspect='true' img-color='#AAA' active='~show-lock'/>
          </horizontal>
          <horizontal pref-width='30' pref-height='10'  vertical-fit='PreferredSize' horizontal-fit='PreferredSize'>
            <page-button id='event-prev' direction='Left' pref-width='3.5' on-click='OnEventPrev'/>
            <text text='~week-pagnation' font-size='4.5' align='Center'/>
            <page-button id='event-next' direction='Right' pref-width='3.5' on-click='OnEventNext' />
          </horizontal>
        </horizontal>
        <horizontal pref-height='35' pref-width='70' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' active='~is-event-not-loading'>
          <custom-list id='event-list' contents='event-cells' _children='~event-mission-list-content' stick-scrolling='true' show-scrollbar='true' clickable-cells='true' cell-size='12' visible-cells='3' select-cell='on-cell-click-event' list-width='65'/>
          <vertical pref-width='5'/>
        </horizontal>
        <horizontal pref-height='35' pref-width='70' horizontal-fit='PreferredSize' vertical-fit='PreferredSize' active='~is-event-loading'>
          <loading preserve-aspect='true' pref-height='5'/>
        </horizontal>
      </vertical>
      <vertical  pref-width='75' child-expand-height='false' bg='panel-top' skew='0' active='~event-not-begun'>
        <vertical pref-height='35' pref-width='65'>
          <text id='begin-event-status' align='Center' word-wrapping='true' font-size='4' text='Click here to begin the event and access your missions!'/>
          <button text='Begin!' on-click='on-event-begin' preferred-width='45' pref-height='10' vertical-fit='PreferredSize' horizontal-fit='PreferredSize' />
        </vertical>
      </vertical>
    </horizontal>
  </vertical>
</bg>