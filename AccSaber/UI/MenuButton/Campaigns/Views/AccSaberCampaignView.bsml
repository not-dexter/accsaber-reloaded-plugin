<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <vertical pref-width='120'>
    <vertical vertical-fit='PreferredSize' horizontal-fit='PreferredSize' pref-height='8' pref-width='80' pad='1' pad-top='0' active='~not-in-campaign'>
      <tab-selector tab-tag='tabs' id='tab-selector' select-cell='tab-selected' />
    </vertical>
    <tab tags='tabs' tab-name='Active' />
    <tab tags='tabs' tab-name='Curated' />
    <tab tags='tabs' tab-name='All' />
	<tab tags='tabs' tab-name='Completed'/>
    <horizontal pref-width='160' spacing='1' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'>
      <horizontal>
        <vertical pref-width='50' pref-height='70' pad='2' active='~not-in-campaign'>
          <custom-list id='campaign-list' contents='campaign-cells' cell-size='12'  clickable-cells='true' select-cell='campaign-selected' visible-cells='4' active='~not-in-campaign'>
            <horizontal bg='round-rect-panel' pref-width='45' horizontal-fit='PreferredSize' pad ='2'>
              <vertical pref-width='32.5'>
                <text align='Left' text='~Name' font-size='3' />
                <text align='Left' text='~Author' font-size='2.5' />
              </vertical>
			  <vertical pref-width='7.5'>
                <text text='~Tags' align='Right' font-size='2.5' />
			  </vertical>		
            </horizontal>
          </custom-list>
        </vertical>
        <vertical pref-width='4' active='~not-in-campaign'>
          <page-button event-click='campaign-list#PageUp' direction='Up' pref-height='3' pref-width='4' />
          <page-button event-click='campaign-list#PageDown' direction='Down' pref-height='3' pref-width='4' />
        </vertical>
      </horizontal>
      <vertical bg='round-rect-panel' pref-width='100' pref-height='70' pad='2' active='~not-in-campaign'>
		 <vertical preferred-width='100' pref-height='40' vertical-fit='PreferredSize' horizontal-fit='PreferredSize' active='~NoCampaignSelected'>
			 <text text='Welcome to AccSaber Reloaded Campaigns!' font-size='5' align='Center' word-wrapping='true' />
			 <text text='Here you will find custom campaigns ranging in difficulty and categody made by the AccSaber community and staff. If you would like to create your own campaign, you can do so on the AccSaber Reloaded website' font-size='3.5' align='Center' word-wrapping='true' />
		 </vertical>
		<vertical active='~CampaignIsSelected' preferred-width='100' horizontal-fit='PreferredSize'>
          <horizontal preferred-width='100' horizontal-fit='PreferredSize'>
            <img preserve-aspect='true' id='CampaignImage' preferred-width='25' preferred-height='25' />
            <vertical preferred-width='60' preferred-height='20' vertical-fit='PreferredSize'>
              <text text='~CampaignTitle' align='Left' font-size='6' />
              <text text='~CampaignCreator' align='Left' font-size='3.5' />
              <text text='~CampaignCategory' align='Left' font-size='3.5' />
            </vertical>
          </horizontal>
          <text text='~CampaignDescription' align='Center' word-wrapping='true' font-size='3.5' />
          <button id='CampaignButton' text='Play Campaign' on-click='PlayCampaign' font-size='4' preferred-width='45' pref-height='10' vertical-fit='PreferredSize' horizontal-fit='PreferredSize' active='~campaign-selected' />
        </vertical>
	  </vertical>
      <vertical active='~in-campaign'>
        <vertical id='CampaignMapContainer' pref-width='80' pref-height='70' pad='2' />
        <horizontal>
          <button text='Zoom In' on-click='ZoomIn' />
          <button text='Go To Map' on-click='GotoMap' />
          <button text='Zoom Out' on-click='ZoomOut' />
          <clickable-image src='#SettingsIcon' preserve-aspect='true' on-click='ShowSettings'/>
        </horizontal>
      </vertical>
      <vertical preferred-width='50' spacing='5' preferred-height='65' bg='round-rect-panel' active='~in-map-or-barrier' pad ='4' pad-bottom='2'>
        <vertical preferred-width='42' preferred-height='15' vertical-fit='PreferredSize' active='~in-map'>
          <horizontal>
            <img preserve-aspect='true' id='MissionImage' preferred-width='8' preferred-height='8' />
            <vertical preferred-width='30'>
              <text text='~MissionMapName' align='Left' overflow-mode='Ellipsis' italics='true' font-size='4' />
              <text text='~MissionMapArtist' color='#c0c2c5' overflow-mode='Ellipsis' italics='true' align='Left' font-size='2.5' />
            </vertical>
          </horizontal>
          <horizontal>
            <horizontal vertical-fit='PreferredSize' pref-height='3' pref-width='6.3'>
              <img src='#ClockIcon' preserve-aspect='true' pref-width='2.6' pref-height='2.6' />
              <text text='~MissionMapDuration' italics='true' font-size='2.5' />
            </horizontal>
            <horizontal vertical-fit='PreferredSize' pref-height='3' pref-width='6.3'>
              <img src='#NPSIcon' preserve-aspect='true' pref-width='2.6' pref-height='2.6' />
              <text text='~MissionMapNPS' italics='true' font-size='2.5' />
            </horizontal>
            <horizontal vertical-fit='PreferredSize' pref-height='3' pref-width='6.3'>
              <img src='#GameNoteIcon' preserve-aspect='true' scale='0.8' pref-width='2.6' pref-height='2.6' />
              <text text='~MissionMapNoteCount' italics='true' font-size='2.5' />
            </horizontal>
            <horizontal vertical-fit='PreferredSize' pref-height='3' pref-width='6.3'>
              <img src='#FastNotesIcon' preserve-aspect='true' pref-width='2.6' pref-height='2.6' />
              <text text='~MissionMapNJS' italics='true' font-size='2.5' />
            </horizontal>
          </horizontal>
        </vertical>
        <vertical preferred-height='35'>
          <text text='Completed!' align='Center' face-color='green' font-size='4' active='~MissionComplete' />
          <vertical pref-height='8' vertical-fit='PreferredSize'>
            <text text='Objective' font-size='4' align='Center' />
            <text text='~MissionObjective' word-wrapping='true' font-size='3' />
          </vertical>
          <vertical pref-height='8' vertical-fit='PreferredSize'>
            <text text='Current Progress' font-size='4' align='Center' />
            <text text='~MissionProgress' align='Center' word-wrapping='false' font-size='3' />
          </vertical>
          <vertical pref-height='8' vertical-fit='PreferredSize' active='~MissionHasRewards'>
            <text text='XP Rewards' font-size='4' align='Center' />
            <text text='~MissionRewards' align='Center' word-wrapping='false' font-size='3' />
          </vertical>
        </vertical>
        <text text='An earlier objective is needed to progress' word-wrapping='true' align='Center' face-color='#fc0d0d' font-size='4' active='~MissionLocked' />
        <button id='MissionButton' text='Play' on-click='PlayMission' font-size='4' preferred-width='45' pref-height='10' vertical-fit='PreferredSize' horizontal-fit='PreferredSize' />
      </vertical>
    </horizontal>
  </vertical>
</bg>