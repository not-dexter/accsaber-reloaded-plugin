<modal id='modal' clickerino-offerino-closerino='true' hide-event='CloseModal' size-delta-x='160' size-delta-y='61' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <vertical child-expand-height='false'>
    <horizontal child-expand-width='false'>
      <vertical horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='80' pref-height='54' child-expand-width='false' pad='2'>
        <checkbox-setting text='Show Terminal Indicator' hover-hint='Whether or not to show the flag on end nodes' apply-on-change='true' value='ShowTerminalIndicator' scale='0.8' />
        <checkbox-setting text='Show Prereq Indicator' hover-hint='Whether or not to show the asterisk on nodes' apply-on-change='true' value='ShowPrereqIndicator' scale='0.8' />
        <checkbox-setting text='Allow Stick Scrolling' apply-on-change='true' value='StickScrolling' scale='0.8' />
        <checkbox-setting text='Campaign Back Button' hover-hint='Whether or not the back button takes you back to the campaign' apply-on-change='true' value='CampaignBackButton' scale='0.8' />
        <slider-setting text='Scroll Speed' apply-on-change='true' value='ScrollSpeed' min='0.25' max='10' increment='0.25' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.8' />
        <vertical pref-height='5' />
        <vertical horizontal-fit='PreferredSize' pref-width='80' pref-height='10' child-expand-width='true' child-align='MiddleCenter'>
          <text text='The below 2 options will affect the load time of the campaign.' font-size='3' align='Center' scale='0.8' />
          <text text='The lower, the slower the load time. Higher is faster, but may cause a lag spike.' font-size='3' align='Center' scale='0.8' />
        </vertical>
        <increment-setting text='Pixels Loaded' hover-hint='The amount of pixels per texture to load in a frame' apply-on-change='true' value='PixelsPerFrame' min='1000' max='50000' increment='1000' integer-only='true' scale='0.8' />
        <increment-setting text='Objects Loaded' hover-hint='The amount of objects in a campaign to load per frame' apply-on-change='true' value='ObjectsPerFrame' min='5' max='100' increment='5' integer-only='true' scale='0.8' />
      </vertical>
      <vertical horizontal-fit='PreferredSize' vertical-fit='PreferredSize' pref-width='80' pref-height='49' child-expand-width='false' pad='2'>
        <vertical>
          <text text='Image Background Color Settings' align='Center' font-size='4' scale='0.8' />
          <slider-setting text='Image Brightness' apply-on-change='true' value='ImgBGBrightness' min='0' max='1' increment='0.05' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.7' />
          <slider-setting text='Image Opacity' apply-on-change='true' value='ImgBGAlpha' min='0' max='1' increment='0.05' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.7' />
        </vertical>
        <vertical pref-height='20' />
        <vertical>
          <text text='Solid Background Color Settings' align='Center' font-size='4' scale='0.8' />
          <slider-setting text='Color Brightness' apply-on-change='true' value='ColorBGBrightness' min='0' max='1' increment='0.05' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.7' />
          <slider-setting text='Color Opacity' apply-on-change='true' value='ColorBGAlpha' min='0' max='1' increment='0.05' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.7' />
        </vertical>
      </vertical>
    </horizontal>
    <vertical pref-height='7' pad-bottom='2'>
      <button text='Exit' click-event='CloseModal' align='Center' />
    </vertical>
  </vertical>
</modal>