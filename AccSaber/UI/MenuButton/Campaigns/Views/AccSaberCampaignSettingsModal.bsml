<modal id='modal' clickerino-offerino-closerino='true' size-delta-x='80' size-delta-y='30' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <vertical horizontal-fit='PreferredSize' pref-width='80' child-expand-width='false'>
    <checkbox-setting text='Allow Stick Scrolling' apply-on-change='true' value='StickScrolling' scale='0.8' />
    <slider-setting text='Scroll Speed' apply-on-change='true' value='ScrollSpeed' min='0.25' max='10' increment='0.25' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.8' />
    <checkbox-setting text='Show Prereq Indicator' hover-hint='Whether or not to show the asterisk on nodes' apply-on-change='true' value='ShowPrereqIndicator' scale='0.8' />
    <slider-setting text='Background Brightness' apply-on-change='true' value='BGBrightness' min='0' max='1' increment='0.05' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.8' />
    <slider-setting text='Background Alpha' apply-on-change='true' value='BGAlpha' min='0' max='1' increment='0.05' integer-only='false' show-buttons='true' word-wrapping='false' scale='0.8' />
  </vertical>
</modal>