<vertical pref-width='~ViewportWidth' pref-height='~ViewportHeight' child-expand-width='false' child-expand-height='false' pad='2' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
  <vertical pref-width='~ViewportWidth' pref-height='~ViewportHeight'>
    <scrollable-container-2d id='ScrollContainer' viewport-width='~ViewportWidth' viewport-height='~ViewportHeight'>
      <vertical id='NodeContainer' pref-width='100' pref-height='100' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'/>
    </scrollable-container-2d>
  </vertical>
</vertical>